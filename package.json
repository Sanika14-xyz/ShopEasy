{
  "name": "shopeasy-devops",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace api\" \"npm run dev --workspace web\"",
    "test": "npm test --workspace api",
    "build": "npm run build --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
